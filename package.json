{
  "name": "wealthcurve",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/src/core/index.d.ts",
      "default": "./lib/src/core/index.js"
    },
    "./quotes": {
      "types": "./lib/server/quotes.d.ts",
      "default": "./lib/server/quotes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "demo": "tsx scripts/headless-demo.ts",
    "icons": "tsx scripts/icons.ts",
    "worldmap": "tsx scripts/worldmap.ts",
    "serve": "tsx scripts/serve.ts",
    "mcp": "tsx mcp/server.ts",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/caveat": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-is": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.2",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.43.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "react-is": "^19.2.8"
  }
}
