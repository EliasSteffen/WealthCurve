{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode - vite.config.ts und scripts/ werden von esbuild bzw. tsx
       geladen, nicht von Node direkt. src/core und server/quotes.ts tragen ihre
       Endungen trotzdem, weil andere Projekte sie mit reinem Node laden (siehe
       node-import.test.ts); im übrigen Code bleiben sie weg. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "server", "scripts"]
}
